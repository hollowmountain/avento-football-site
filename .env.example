# ==== База данных (обязательно) ====
# Локально (портативный PostgreSQL из README): postgresql://postgres@localhost:5433/kickoff_dev
# Railway: возьмите DATABASE_URL из плагина Postgres и добавьте ?sslmode=require
DATABASE_URL="postgresql://postgres@localhost:5433/kickoff_dev"

# ==== Redis (опционально) ====
# Если не задан — rate limit и кэш погоды работают через PostgreSQL (медленнее, но корректно).
# Railway: REDIS_URL из плагина Redis.
# REDIS_URL="redis://default:password@host:6379"

# ==== Секреты (обязательно, минимум 16 символов) ====
# Соль для хеширования токенов организатора/участника. Смена = все токены станут недействительными!
TOKEN_PEPPER="замените-на-длинную-случайную-строку"
# Соль для хеширования IP (сырые IP не хранятся).
IP_HASH_SALT="замените-на-другую-случайную-строку"
# Секрет для POST /api/cron/close-expired (заголовок x-cron-secret).
CRON_SECRET="замените-на-третью-случайную-строку"

# ==== Приложение ====
# Публичный URL — для ссылок-приглашений, ICS и OG-картинок.
APP_URL="http://localhost:3000"
# Дефолты продукта
DEFAULT_CITY="Москва"
DEFAULT_CURRENCY="RUB"
DEFAULT_TIMEZONE="Europe/Moscow"

# ==== Anti-abuse (все значения имеют дефолты, менять не обязательно) ====
# Максимум созданных игр с одного IP за 24 часа
RATE_CREATE_GAME_PER_DAY="3"
# Максимум созданных игр с одного IP за 10 минут
RATE_CREATE_GAME_PER_10MIN="1"
# Максимум одновременно активных (будущих) игр у одного организатора
RATE_MAX_ACTIVE_GAMES_PER_HOST="2"
# Общий лимит мутирующих запросов с одного IP в минуту
RATE_GLOBAL_WRITES_PER_MIN="30"
# Дедупликация: радиус (м) и окно (мин) для запрета дублей игр
DEDUP_RADIUS_METERS="150"
DEDUP_WINDOW_MINUTES="60"
# Time-trap: минимальное время (сек) между рендером и отправкой формы
FORM_MIN_SUBMIT_SECONDS="2"

# ==== Cloudflare Turnstile (опционально) ====
TURNSTILE_ENABLED="false"
# TURNSTILE_SECRET_KEY=""
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# ==== Прочее ====
# TTL кэша погоды, минут
WEATHER_CACHE_TTL_MINUTES="60"
# Размер пула соединений PostgreSQL (для Railway с pooler держите небольшим)
PG_POOL_MAX="10"
# Геокодер адресов: nominatim (по умолчанию, без ключа) или stub без сети — для тестов
GEOCODER="nominatim"
