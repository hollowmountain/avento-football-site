generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GameStatus {
  OPEN
  FULL
  CANCELLED_BY_HOST
  CANCELLED_NOT_ENOUGH
  FINISHED
  // Снята владельцем сайта (модерация): в ленте не показывается,
  // но остаётся в кабинетах участников с причиной снятия
  REMOVED_BY_ADMIN
}

enum GameFormat {
  FREE
  FIVE_A_SIDE
  SIX_A_SIDE
  SEVEN_A_SIDE
  EIGHT_A_SIDE
  ELEVEN_A_SIDE
}

// 5 уровней игрока (ANY — «не указан»; ADVANCED — легаси, в UI = SEMI_PRO)
enum SkillLevel {
  ANY
  BEGINNER
  AMATEUR
  INTERMEDIATE
  ADVANCED
  SEMI_PRO
  PRO
}

enum Position {
  GOALKEEPER
  DEFENDER
  MIDFIELDER
  FORWARD
  ANY
}

enum Attendance {
  CONFIRMED
  MAYBE
}

enum ParticipantRole {
  MAIN
  WAITLIST
}

enum Gender {
  MALE
  FEMALE
}

// Видимость игры: публичные создают только согласованные теги (ENV
// PUBLIC_GAME_TAGS), остальные собирают друзей приватно — по ссылке
// с ключом или по паролю. В ленте видны все игры.
enum GameVisibility {
  PUBLIC
  PRIVATE_LINK
  PRIVATE_PASSWORD
}

// Личный кабинет: профиль с уникальным тегом (как в Telegram).
// Пароля нет: устройства привязываются анонимным cookie, вход с нового —
// по личному коду (хранится только HMAC-хеш, как у host-токенов).
model UserProfile {
  id            String   @id @default(cuid())
  tag           String   @unique // lowercase, 3–20 символов [a-z0-9_]
  displayName   String
  age           Int?
  gender        Gender?
  // ISO 3166-1 alpha-2 в нижнем регистре — флаг «для красоты»
  countryCode   String?
  // Любимый клуб (id из палитры клубов) — значок рядом с именем
  club          String?
  // Уровень игрока: живёт в профиле, подставляется при записи на игры
  skillLevel    SkillLevel @default(ANY)
  loginCodeHash String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  devices      ProfileDevice[]
  participants Participant[]
  createdGames Game[]        @relation("createdGames")
  managedGames Game[]        @relation("managedGames")
}

// Устройство = анонимный cookie kickoff_pid; один профиль — много устройств.
model ProfileDevice {
  tokenHash String      @id
  profileId String
  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@index([profileId])
}

model Game {
  id              String     @id @default(cuid())
  code            String     @unique // KCK-7F2A
  title           String
  description     String?    @db.Text
  status          GameStatus @default(OPEN)
  format          GameFormat
  skillLevel      SkillLevel
  startsAt        DateTime
  // null — «как получится»: длительность не фиксирована
  durationMinutes Int?
  // Сколько команд играет в этот день (2–4, лишние ждут очереди)
  teamCount       Int        @default(2)
  timezone        String     @default("Europe/Moscow") // IANA tz; startsAt хранится в UTC
  minPlayers      Int
  maxPlayers      Int
  pricePerPitch   Int        @default(0) // в минимальных единицах валюты (копейки)
  currency        String     @default("RUB")
  cancelDeadline  DateTime
  venueName       String
  address         String
  latitude        Float
  longitude       Float
  city            String
  visibility      GameVisibility @default(PUBLIC)
  // Хеш ключа записи для приватных игр (ссылка или пароль)
  joinKeyHash     String?
  // Ключ-приглашение открытым текстом — ТОЛЬКО для PRIVATE_LINK
  // (случайный код, нужен организатору для повторного шаринга ссылки).
  // Пароль PRIVATE_PASSWORD открытым текстом не хранится никогда.
  inviteKey       String?
  hostTokenHash   String // хеш токена, plain-токен не хранится
  hostName        String
  createdIpHash   String // хеш IP + соль, сам IP не хранится (GDPR)
  // Хеш анонимного identity-токена создателя (лимит одновременных игр на организатора)
  creatorTokenHash String?
  // Кабинет создателя: с ним связаны права организатора и матч-день
  creatorProfileId String?
  creatorProfile   UserProfile? @relation("createdGames", fields: [creatorProfileId], references: [id], onDelete: SetNull)
  // Менеджер матч-дня: создатель может передать протокол кому-то из
  // записавшихся. null — ведёт сам создатель.
  managerProfileId String?
  managerProfile   UserProfile? @relation("managedGames", fields: [managerProfileId], references: [id], onDelete: SetNull)
  teamsSnapshot   Json? // результат жеребьёвки
  // Модерация: код причины снятия (WRONG_TITLE, MISTAKE, DUPLICATE, RULES, OTHER)
  // и пояснение владельца — их видят участники в своём кабинете
  removalReason   String?
  removalNote     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  participants Participant[]
  matchDay     MatchDay?

  @@index([startsAt, status])
  @@index([city, startsAt])
  @@index([hostTokenHash, startsAt])
  @@index([creatorTokenHash, startsAt])
}

model Participant {
  id            String          @id @default(cuid())
  gameId        String
  game          Game            @relation(fields: [gameId], references: [id], onDelete: Cascade)
  name          String
  nickname      String
  position      Position
  // Самооценка уровня — участвует в балансировке команд
  skillLevel    SkillLevel      @default(ANY)
  attendance    Attendance
  role          ParticipantRole
  waitlistOrder Int?
  tokenHash     String
  joinedAt      DateTime        @default(now())
  leftAt        DateTime?
  wasLateCancel Boolean         @default(false)
  // Профиль участника (null — гость без кабинета)
  profileId     String?
  profile       UserProfile?    @relation(fields: [profileId], references: [id], onDelete: SetNull)

  // Матч-день: команда дня и голы, записанные на этого участника
  dayMember     MatchDayMember?
  goalsScored   DayGoal[]       @relation("goalScorer")
  goalsAssisted DayGoal[]       @relation("goalAssist")

  @@unique([gameId, nickname])
  @@index([gameId, role, waitlistOrder])
  @@index([tokenHash])
  @@index([profileId])
}

// ─── Матч-день обычной игры ────────────────────────────────────────────────
// Тот же протокол, что в «Быстрой игре», но на сервере: его ведёт менеджер,
// видят все, а голы привязаны к участникам (и через них — к кабинетам).

enum MatchDayStatus {
  LIVE
  FINISHED
}

enum DayMatchStatus {
  LIVE
  FINISHED
}

model MatchDay {
  id         String         @id @default(cuid())
  gameId     String         @unique
  game       Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  status     MatchDayStatus @default(LIVE)
  startedAt  DateTime       @default(now())
  finishedAt DateTime?
  // Очередь команд: { playing: [teamId, teamId], waiting: [teamId, ...] }
  rotation   Json?
  updatedAt  DateTime       @updatedAt

  teams   MatchDayTeam[]
  members MatchDayMember[]
  matches DayMatch[]
}

model MatchDayTeam {
  id      String   @id @default(cuid())
  dayId   String
  day     MatchDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  name    String
  // Пресет палитры «Быстрой игры»: amber | green | coral | sky | violet | paper
  colorId String
  order   Int

  members     MatchDayMember[]
  homeMatches DayMatch[]       @relation("homeTeam")
  awayMatches DayMatch[]       @relation("awayTeam")
  goals       DayGoal[]

  @@index([dayId, order])
}

// Кто за какую команду играет сегодня. Участник может быть без команды —
// например, пришёл поздно и ждёт, куда его поставят.
model MatchDayMember {
  id            String        @id @default(cuid())
  dayId         String
  day           MatchDay      @relation(fields: [dayId], references: [id], onDelete: Cascade)
  participantId String        @unique
  participant   Participant   @relation(fields: [participantId], references: [id], onDelete: Cascade)
  teamId        String?
  team          MatchDayTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([dayId])
  @@index([teamId])
}

model DayMatch {
  id     String         @id @default(cuid())
  dayId  String
  day    MatchDay       @relation(fields: [dayId], references: [id], onDelete: Cascade)
  // Номер матча в дне, с единицы
  order  Int
  status DayMatchStatus @default(LIVE)

  homeTeamId String
  homeTeam   MatchDayTeam @relation("homeTeam", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeamId String
  awayTeam   MatchDayTeam @relation("awayTeam", fields: [awayTeamId], references: [id], onDelete: Cascade)

  // Таймер: накопленное до паузы время плюс отсчёт от timerStartedAt
  timerRunning   Boolean   @default(true)
  accumulatedMs  Int       @default(0)
  timerStartedAt DateTime?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  goals DayGoal[]

  @@index([dayId, order])
}

// Гол: счёт матча считается по этим строкам, отдельного поля счёта нет.
// Автор и ассистент — участники игры (null у гола «без автора»).
model DayGoal {
  id      String       @id @default(cuid())
  matchId String
  match   DayMatch     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamId  String
  team    MatchDayTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  scorerParticipantId String?
  scorer              Participant? @relation("goalScorer", fields: [scorerParticipantId], references: [id], onDelete: SetNull)
  assistParticipantId String?
  assist              Participant? @relation("goalAssist", fields: [assistParticipantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([matchId, createdAt])
  @@index([scorerParticipantId])
  @@index([assistParticipantId])
}

// Reliability score: живёт дольше одной игры, ключ — хеш participantToken.
model ParticipantProfile {
  tokenHash     String   @id
  gamesJoined   Int      @default(0)
  gamesAttended Int      @default(0)
  lateCancels   Int      @default(0)
  updatedAt     DateTime @updatedAt
}

// Fallback-хранилище rate limit, когда Redis недоступен или не сконфигурирован.
model RateLimitEvent {
  id        String   @id @default(cuid())
  key       String // "create_game:ip:<hash>"
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  gameId    String?
  action    String // GAME_CREATED, PARTICIPANT_JOINED, ...
  payload   Json
  createdAt DateTime @default(now())

  @@index([gameId, createdAt])
}

// Кэш ответов Open-Meteo (TTL контролируется по fetchedAt).
model WeatherCache {
  key       String   @id // "lat:lon:isoHour"
  payload   Json
  fetchedAt DateTime @default(now())
}
